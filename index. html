<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Braj Darshan - Smart Pilgrimage Guide</title>
    
    <!-- Leaflet CSS & Routing CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Yatra+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* === BASE STYLES === */
        body { margin: 0; padding: 0; font-family: 'Poppins', sans-serif; background-color: #Fdf4e3; overflow: hidden; }
        .logo-title { font-family: 'Yatra One', serif; color: #005A9C; font-size: 40px; margin-bottom: 20px; }
        .subtitle { font-size: 20px; color: #FF9933; }
        .input-box, .btn { padding: 12px 20px; margin: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 16px; width: 80%; max-width: 300px; }
        .btn { background-color: #FF9933; color: white; border: none; cursor: pointer; font-weight: 600; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .btn:hover { background-color: #e67e22; }

        /* === SCREENS === */
        .onboarding-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; width: 100vw; text-align: center; position: absolute; top: 0; left: 0; background-color: #Fdf4e3; z-index: 2000; }
        #main-ui { display: none; height: 100vh; width: 100vw; position: relative; }
        #tour-map { width: 100%; height: 100%; z-index: 1; }

        /* === BARS & CONTROLS === */
        .top-floating-bar { position: absolute; top: 15px; left: 15px; right: 15px; background: white; padding: 10px 15px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.2); z-index: 1000; }
        .top-left { display: flex; align-items: center; gap: 10px; }
        .top-left span { font-family: 'Yatra One', serif; color: #005A9C; font-size: 18px; }
        .lang-toggle { background: #005A9C; color: white; border: none; border-radius: 5px; cursor: pointer; padding: 5px 8px; font-weight: bold; }
        .ai-guide-btn { background: #FDEBD0; color: #d35400; padding: 5px 10px; border-radius: 20px; font-size: 14px; font-weight: bold; cursor: pointer; }
        .top-right { display: flex; gap: 15px; color: #555; font-size: 20px; cursor: pointer; }

        .search-floating-bar { position: absolute; top: 75px; left: 15px; right: 15px; display: flex; gap: 8px; z-index: 1000; }
        .search-floating-bar input { flex-grow: 1; padding: 10px 18px; border: 2px solid #FF9933; border-radius: 25px; font-family: 'Poppins', sans-serif; box-shadow: 0 4px 6px rgba(0,0,0,0.1); outline: none; }
        .search-floating-bar button { background-color: #005A9C; color: white; border: none; padding: 10px 16px; border-radius: 50%; cursor: pointer; }

        .bottom-floating-bar { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); background: white; padding: 10px 20px; border-radius: 30px; display: flex; justify-content: space-around; align-items: center; width: 90%; max-width: 400px; box-shadow: 0 -4px 10px rgba(0,0,0,0.2); z-index: 1000; }
        .bottom-action { display: flex; flex-direction: column; align-items: center; color: #005A9C; font-size: 12px; cursor: pointer; gap: 5px; }
        .bottom-action i { font-size: 20px; color: #FF9933; }
        .contribute-btn i { background: #FF9933; color: white; padding: 12px; border-radius: 50%; margin-top: -25px; border: 4px solid #Fdf4e3; font-size: 24px; }

        /* === ANIMATIONS & MODALS === */
        @keyframes pulseGlow { 0% { text-shadow: 0 0 5px #FF9933; transform: scale(1); } 50% { text-shadow: 0 0 15px #FF9933, 0 0 25px #d35400; transform: scale(1.1); } 100% { text-shadow: 0 0 5px #FF9933; transform: scale(1); } }
        .user-live-icon { font-size: 28px; animation: pulseGlow 1.5s infinite; }
        @keyframes micActive { 0% { color: #555; } 50% { color: red; text-shadow: 0 0 10px red; transform: scale(1.2); } 100% { color: #555; } }
        .mic-listening { animation: micActive 1s infinite; }

        .profile-modal { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 3000; display: flex; justify-content: center; align-items: center; }
        .profile-content { background: #FFF9F0; padding: 25px; border-radius: 15px; width: 80%; max-width: 320px; text-align: center; border: 3px solid #FF9933; position: relative; }
        .close-btn { position: absolute; top: 10px; right: 15px; font-size: 28px; cursor: pointer; color: #d35400; }
    </style>
</head>
<body>

    <!-- STEP 1: Login -->
    <div id="step1" class="onboarding-screen">
        <h1 class="logo-title">Braj Darshan</h1>
        <input type="email" id="userEmailInput" class="input-box" placeholder="Email / Login ID">
        <button class="btn" onclick="loginUser()">Login</button>
    </div>

    <!-- STEP 2: Location -->
    <div id="step2" class="onboarding-screen" style="display: none;">
        <i class="fas fa-map-marker-alt" style="font-size: 50px; color: #FF9933; margin: 20px;"></i>
        <p>Live Location Allow Karein</p>
        <button class="btn" onclick="requestLocation()">Allow Location</button>
    </div>

    <!-- MAIN UI (Step 4) -->
    <div id="main-ui">
        <!-- Top Bar -->
        <div class="top-floating-bar">
            <div class="top-left">
                <span>Braj Darshan</span>
                <button class="lang-toggle" onclick="toggleLanguage()">A/अ</button>
                <div class="ai-guide-btn" onclick="playWelcomeAudio()"><i class="fas fa-robot"></i> <span id="ui-guide">Guide</span></div>
            </div>
            <div class="top-right">
                <i id="mic-btn" class="fas fa-microphone" onclick="startVoiceCommand()"></i>
                <i class="fas fa-user-circle" onclick="openProfile()"></i>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="search-floating-bar">
            <input type="text" id="searchInput" placeholder="Mandir ya sthan khojein...">
            <button onclick="searchTemple()"><i class="fas fa-search"></i></button>
        </div>

        <!-- Map -->
        <div id="tour-map"></div>

        <!-- Bottom Bar -->
        <div class="bottom-floating-bar">
            <div class="bottom-action" onclick="findNearestTemple()">
                <i class="fas fa-compass"></i><span id="ui-explore">Explore</span>
            </div>
            <div class="bottom-action contribute-btn" onclick="openContribute()">
                <i class="fas fa-plus"></i><span id="ui-contribute">Contribute</span>
            </div>
            <div class="bottom-action" onclick="shareAppLocation()">
                <i class="fas fa-share-alt"></i><span id="ui-share">Share</span>
            </div>
            <div class="bottom-action" onclick="toggleMapLayer()">
                <i class="fas fa-layer-group"></i><span id="ui-layers">Layers</span>
            </div>
        </div>
    </div>

    <!-- Profile Modal -->
    <div id="profileModal" class="profile-modal" style="display:none;">
        <div class="profile-content">
            <span class="close-btn" onclick="document.getElementById('profileModal').style.display='none'">×</span>
            <h2 style="color: #005A9C;"><i class="fas fa-user-circle"></i> Profile</h2>
            <p id="profileEmail" style="font-weight: bold; color: #d35400;">Guest</p>
            <div style="background: white; padding: 15px; border-radius: 10px; border: 1px solid #FDEBD0;">
                <h3>Yatra Stats 🚩</h3>
                <p>Darshan Purna: <b id="visitedCount">0</b> / 12</p>
                <p>Agla Target: <b id="currentTargetDisplay">Explore Karein</b></p>
            </div>
        </div>
    </div>

    <!-- Contribute Modal -->
    <div id="contributeModal" class="profile-modal" style="display:none;">
        <div class="profile-content">
            <span class="close-btn" onclick="document.getElementById('contributeModal').style.display='none'">×</span>
            <h2 style="color: #005A9C;"><i class="fas fa-plus-circle"></i> Naya Sthan</h2>
            <input type="text" id="newPlaceName" class="input-box" style="width: 80%;" placeholder="Jagah ka naam">
            <button class="btn" style="width: 90%; margin-top: 15px;" onclick="submitContribution()">Submit Data</button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>

    <script>
        // ================= VARIABLES & DATA =================
        let map, streetLayer, satelliteLayer, routeControl = null;
        let isSatellite = false, isHindi = false;
        let userLocation = null, userMarker = null, watchId = null;
        let userEmail = "Guest";
        let currentTargetTemple = null;

        let templesData = [
            { id: 1, name: "Shri Krishna Janmabhoomi", lat: 27.5028, lng: 77.6683, morningClose: "12:00", eveningOpen: "15:00", eveningClose: "21:30", visited: false },
            { id: 2, name: "Shri Banke Bihari Ji", lat: 27.5815, lng: 77.6992, morningClose: "12:00", eveningOpen: "17:30", eveningClose: "21:30", visited: false },
            { id: 3, name: "Prem Mandir", lat: 27.5714, lng: 77.6720, morningClose: "12:00", eveningOpen: "16:30", eveningClose: "20:30", visited: false },
            { id: 4, name: "Shri Dwarkadhish Mandir", lat: 27.5042, lng: 77.6830, morningClose: "12:30", eveningOpen: "17:00", eveningClose: "21:00", visited: false },
            { id: 5, name: "ISKCON Mandir", lat: 27.5719, lng: 77.6775, morningClose: "12:45", eveningOpen: "16:30", eveningClose: "20:45", visited: false },
            { id: 6, name: "Shri Radha Rani (Barsana)", lat: 27.6495, lng: 77.3752, morningClose: "14:00", eveningOpen: "17:00", eveningClose: "21:00", visited: false },
            { id: 7, name: "Nand Bhavan", lat: 27.7114, lng: 77.3856, morningClose: "14:00", eveningOpen: "16:00", eveningClose: "21:00", visited: false },
            { id: 8, name: "Daan Ghati (Govardhan)", lat: 27.4954, lng: 77.4629, morningClose: "22:00", eveningOpen: "22:00", eveningClose: "22:00", visited: false },
            { id: 9, name: "Raman Reti", lat: 27.4310, lng: 77.7280, morningClose: "12:00", eveningOpen: "16:00", eveningClose: "21:00", visited: false },
            { id: 10, name: "Dauji Maharaj", lat: 27.4071, lng: 77.8223, morningClose: "12:00", eveningOpen: "16:00", eveningClose: "21:00", visited: false },
            { id: 11, name: "Shri Madan Mohan", lat: 27.5803, lng: 77.6877, morningClose: "12:00", eveningOpen: "16:30", eveningClose: "20:30", visited: false },
            { id: 12, name: "Kirti Mandir", lat: 27.6556, lng: 77.3795, morningClose: "12:00", eveningOpen: "16:30", eveningClose: "20:30", visited: false }
        ];

        const translations = {
            en: { explore: "Explore", contribute: "Contribute", share: "Share", layers: "Layers", guide: "Guide", langCode: "en-IN", welcome: "Welcome to Braj Darshan!" },
            hi: { explore: "मार्ग", contribute: "योगदान", share: "साझा", layers: "मैप", guide: "गाइड", langCode: "hi-IN", welcome: "ब्रज दर्शन में आपका स्वागत है!" }
        };

        // ================= API & INIT FUNCTIONS =================
        async function loginUser() {
            let email = document.getElementById('userEmailInput').value;
            if (email.trim() !== "") {
                userEmail = email;
                // Backend call (Error aaye toh bhi frontend chalta rahega)
                try {
                    await fetch('http://localhost:3000/api/login', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: userEmail })
                    });
                } catch(e) { console.log("Backend not connected, running locally."); }
            }
            document.getElementById('step1').style.display = 'none';
            document.getElementById('step2').style.display = 'flex';
        }

        async function submitContribution() {
            let place = document.getElementById('newPlaceName').value;
            if(place.trim() === "") return alert("Naam likhein!");
            
            try {
                let res = await fetch('http://localhost:3000/api/contribute', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail, place_name: place })
                });
                if(res.ok) alert(`"${place}" data submit ho gaya!`);
            } catch(e) { alert("Local submit success!"); }
            
            document.getElementById('newPlaceName').value = "";
            document.getElementById('contributeModal').style.display = 'none';
        }

        // ================= MAP & GPS LOGIC =================
        function requestLocation() {
            if (navigator.geolocation) {
                watchId = navigator.geolocation.watchPosition(
                    (pos) => {
                        userLocation = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                        if (userMarker) userMarker.setLatLng([userLocation.lat, userLocation.lng]);
                        
                        // Geofencing Check (50 meters)
                        if (currentTargetTemple) {
                            let dist = calculateDistance(userLocation.lat, userLocation.lng, currentTargetTemple.lat, currentTargetTemple.lng);
                            if (dist < 0.05) { 
                                alert(`✅ Task Completed: ${currentTargetTemple.name}`);
                                speakAudio(isHindi ? "दर्शन पूरा हुआ!" : "Task Completed!");
                                templesData.find(t => t.id === currentTargetTemple.id).visited = true;
                                currentTargetTemple = null; 
                                if (routeControl) map.removeControl(routeControl);
                            }
                        }
                        // Open Map screen on first load
                        if (document.getElementById('step2').style.display !== 'none') {
                            document.getElementById('step2').style.display = 'none';
                            document.getElementById('main-ui').style.display = 'block';
                            initMap();
                        }
                    },
                    (err) => { alert("Location required!"); },
                    { enableHighAccuracy: true }
                );
            }
        }

        function initMap() {
            map = L.map('tour-map', { zoomControl: false }).setView([userLocation.lat, userLocation.lng], 14);
            L.control.zoom({ position: 'bottomright' }).addTo(map);

            streetLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}').addTo(map);
            satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');

            const charanIcon = L.divIcon({ html: '<div class="user-live-icon">👣</div>', className: '', iconSize: [30, 30] });
            userMarker = L.marker([userLocation.lat, userLocation.lng], { icon: charanIcon }).addTo(map);

            const templeIcon = L.divIcon({ html: '<div style="font-size: 28px;">🛕</div>', className: '', iconSize: [28,28] });
            templesData.forEach(t => L.marker([t.lat, t.lng], { icon: templeIcon }).bindPopup(`<b>${t.name}</b>`).addTo(map));
        }

        // ================= ROUTING & ALGORITHMS =================
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
            const a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }

        function checkTempleStatus(temple) {
            let d = new Date(), hr = d.getHours(), min = d.getMinutes();
            if(hr<10) hr="0"+hr; if(min<10) min="0"+min;
            let cur = hr + ":" + min;
            if (cur >= temple.morningClose && cur < temple.eveningOpen) return isHindi ? "⚠️ मंदिर विश्राम में है" : "⚠️ Temple on Rest";
            else if (cur >= temple.eveningClose) return isHindi ? "🌙 दर्शन समाप्त" : "🌙 Closed for today";
            return isHindi ? "✅ मंदिर खुला है" : "✅ Temple is Open";
        }

        function findNearestTemple() {
            if(!userLocation) return;
            let nearest = null, shortDist = Infinity;
            templesData.filter(t => !t.visited).forEach(t => {
                let dist = calculateDistance(userLocation.lat, userLocation.lng, t.lat, t.lng);
                if (dist < shortDist) { shortDist = dist; nearest = t; }
            });

            if(!nearest) return alert("All tasks completed!");
            currentTargetTemple = nearest;
            drawRoute(nearest);
            let status = checkTempleStatus(nearest);
            speakAudio(`Agla task ${nearest.name}, doori ${shortDist.toFixed(1)} km. ${status}`);
        }

        function drawRoute(temple) {
            if (routeControl) map.removeControl(routeControl);
            routeControl = L.Routing.control({
                waypoints: [L.latLng(userLocation.lat, userLocation.lng), L.latLng(temple.lat, temple.lng)],
                show: false, addWaypoints: false, lineOptions: { styles: [{ color: '#FF9933', weight: 6 }] }
            }).addTo(map);
        }

        function searchTemple() {
            let q = document.getElementById('searchInput').value.toLowerCase();
            let found = templesData.find(t => t.name.toLowerCase().includes(q));
            if(found) {
                currentTargetTemple = found;
                drawRoute(found);
                map.setView([found.lat, found.lng], 15);
                speakAudio(isHindi ? "रास्ता तैयार है" : "Route created");
            } else alert("Not found!");
        }

        // ================= UI, AUDIO & MIC =================
        function toggleLanguage() {
            isHindi = !isHindi;
            let l = isHindi ? 'hi' : 'en';
            document.getElementById('ui-explore').innerText = translations[l].explore;
            document.getElementById('ui-contribute').innerText = translations[l].contribute;
            document.getElementById('ui-share').innerText = translations[l].share;
            document.getElementById('ui-layers').innerText = translations[l].layers;
            document.getElementById('ui-guide').innerText = translations[l].guide;
        }

        function speakAudio(text) {
            if('speechSynthesis' in window) {
                let u = new SpeechSynthesisUtterance(text);
                u.lang = isHindi ? 'hi-IN' : 'en-IN'; u.rate = 0.9;
                window.speechSynthesis.speak(u);
            }
        }
        function playWelcomeAudio() { speakAudio(isHindi ? translations.hi.welcome : translations.en.welcome); }

        function startVoiceCommand() {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if(!SR) return alert("Mic not supported in this browser.");
            let rec = new SR();
            rec.lang = isHindi ? 'hi-IN' : 'en-IN';
            
            document.getElementById('mic-btn').classList.add('mic-listening');
            rec.start();
            speakAudio(isHindi ? "बताइये" : "Speak now");

            rec.onresult = (e) => {
                let t = e.results[0][0].transcript.toLowerCase();
                if(t.includes("explore") || t.includes("रास्ता")) findNearestTemple();
                else if(t.includes("profile") || t.includes("प्रोफाइल")) openProfile();
            };
            rec.onend = () => document.getElementById('mic-btn').classList.remove('mic-listening');
        }

        function toggleMapLayer() {
            if(isSatellite) { map.removeLayer(satelliteLayer); streetLayer.addTo(map); }
            else { map.removeLayer(streetLayer); satelliteLayer.addTo(map); }
            isSatellite = !isSatellite;
        }

        function openProfile() {
            document.getElementById('profileEmail').innerText = userEmail;
            document.getElementById('visitedCount').innerText = templesData.filter(t => t.visited).length;
            document.getElementById('currentTargetDisplay').innerText = currentTargetTemple ? currentTargetTemple.name : "None";
            document.getElementById('profileModal').style.display = 'flex';
        }
        function openContribute() { document.getElementById('contributeModal').style.display = 'flex'; }
        function shareAppLocation() { navigator.share ? navigator.share({url: window.location.href}) : alert("Copy link!"); }
    </script>
</body>
</html>
